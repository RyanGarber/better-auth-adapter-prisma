{
  "name": "@ryangarber/better-auth-adapter-prisma",
  "type": "module",
  "version": "0.1.8",
  "description": "Better Auth adapter for Prisma 8 PostgreSQL with codec-preserving additional user fields",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check --write",
    "test": "vitest run",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm typecheck:contract && pnpm build && pnpm test",
    "typecheck": "tsc --noEmit",
    "release": "bumpp --commit --push --tag && pnpm publish",
    "typecheck:contract": "tsc -p tsconfig.contract.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/better-auth-adapter-prisma.git"
  },
  "keywords": [
    "better-auth",
    "prisma",
    "adapter"
  ],
  "author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@better-auth/core": "^1.7.7",
    "@biomejs/biome": "^2.5.15",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "@prisma/orm-toolchain": "8.0.0-rc.17",
    "@ryangarber/prisma-orm-extension-zod": "^0.2.8",
    "@types/node": "^26.6.4",
    "better-auth": "^1.7.7",
    "bumpp": "^12.3.0",
    "temporal-spec": "^1.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "@better-auth/core": "^1.7.0",
    "@prisma/orm-postgres": "8.0.0-rc.17"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
