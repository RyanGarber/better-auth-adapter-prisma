{
  "name": "@ryangarber/better-auth-adapter-prisma",
  "type": "module",
  "version": "0.1.3",
  "description": "Better Auth adapter for Prisma 8 PostgreSQL with codec-preserving additional user fields",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check --write",
    "test": "vitest run",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm typecheck:contract && pnpm build && pnpm test",
    "typecheck": "tsc --noEmit",
    "release": "bumpp --commit --push --tag && pnpm publish",
    "typecheck:contract": "tsc -p tsconfig.contract.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/better-auth-prisma-8-adapter.git"
  },
  "keywords": [
    "better-auth",
    "prisma",
    "adapter"
  ],
  "author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@better-auth/core": "^1.7.5",
    "@biomejs/biome": "^2.5.14",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@prisma/orm-toolchain": "8.0.0-rc.11",
    "@ryangarber/prisma-orm-extension-zod": "^0.2.4",
    "@types/node": "^26.6.2",
    "better-auth": "^1.7.5",
    "bumpp": "^12.3.0",
    "temporal-spec": "^1.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "@better-auth/core": "^1.7.5",
    "@prisma/orm-postgres": "8.0.0-rc.11"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
